<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tandem.App.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Tandem.App"
    xmlns:vm="using:Tandem.App.ViewModels"
    xmlns:companion="using:Tandem.Core.Companion">

    <Grid MaxWidth="920" Padding="40,28,40,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Notifications" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind CountText(Notifications.Items.Count, Notifications.IsConnected), Mode=OneWay}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Pause_Click" IsEnabled="{x:Bind Notifications.IsConnected, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PauseLabel(Notifications.IsPaused), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind PauseGlyph(Notifications.IsPaused), Mode=OneWay}" FontSize="14" />
                        <TextBlock Text="{x:Bind PauseLabel(Notifications.IsPaused), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Click="ClearAll_Click" IsEnabled="{x:Bind HasItems(Notifications.Items.Count), Mode=OneWay}"
                        AutomationProperties.Name="Clear all">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clear all" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Informational" IsClosable="False"
                 IsOpen="{x:Bind Notifications.IsPaused, Mode=OneWay}"
                 Visibility="{x:Bind app:Ui.Show(Notifications.IsPaused), Mode=OneWay}"
                 Title="Paused" Message="{x:Bind Notifications.PauseText, Mode=OneWay}" />

        <!-- The phone's notification shade -->
        <Grid Grid.Row="2">
            <ListView ItemsSource="{x:Bind Notifications.Items}" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="Item_Click" Padding="0,0,0,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationItem">
                        <Border Style="{StaticResource CardStyle}" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="40" Height="40" VerticalAlignment="Top">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="14" Height="14" />
                                        <TextBlock Text="{x:Bind AppName, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="· Incoming call" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   Visibility="{x:Bind app:Ui.Show(IsIncomingCall), Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />

                                    <ItemsControl ItemsSource="{x:Bind Buttons, Mode=OneWay}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="companion:NotificationAction">
                                                <Button Content="{x:Bind Title}" Click="Action_Click" Padding="12,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid ColumnSpacing="8" Margin="0,6,0,0" Visibility="{x:Bind app:Ui.Show(HasReply), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="Reply" Text="{x:Bind ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="ReplyBox_KeyDown" />
                                        <Button Grid.Column="1" Click="Send_Click" Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Send" AutomationProperties.Name="Send reply">
                                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="More"
                                                AutomationProperties.Name="More options">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Open on this PC" Click="OpenItem_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{x:Bind MuteLabel, Mode=OneWay}" Click="Mute_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7ED;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Click="Dismiss_Click"
                                                ToolTipService.ToolTip="Dismiss on phone" AutomationProperties.Name="Dismiss">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind EmptyVisibility(Notifications.Items.Count), Mode=OneWay}">
                <FontIcon Glyph="&#xEA8F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind EmptyTitle(Notifications.IsConnected), Mode=OneWay}" HorizontalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind EmptyText(Notifications.IsConnected), Mode=OneWay}" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="380" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Grid>

        <!-- Turned-off apps -->
        <Expander Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Visibility="{x:Bind HasMutedVisibility(Notifications.MutedApps.Count), Mode=OneWay}"
                  Header="{x:Bind MutedHeader(Notifications.MutedApps.Count), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Notifications.MutedApps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MutedApp">
                        <Grid Padding="0,4">
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                            <Button Content="Turn back on" HorizontalAlignment="Right" Click="Unmute_Click" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </Grid>
</Page>
