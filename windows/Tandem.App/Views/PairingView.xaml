<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tandem.App.Views.PairingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Tandem.App"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer>
        <Grid MaxWidth="980" Padding="40,28,40,40" ColumnSpacing="48" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Connect your phone" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="Tandem links to your Android phone over Wi-Fi using Android's built-in Wireless debugging. Nothing to install on the phone." />
                </StackPanel>

                <InfoBar Severity="Informational" IsClosable="False"
                         IsOpen="{x:Bind Session.HasUnauthorizedDevice, Mode=OneWay}"
                         Title="Check your phone"
                         Message="Tap Allow on the 'Allow USB debugging?' prompt. Tick 'Always allow from this computer' so you're not asked again." />

                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                            On your phone, open <Bold>Settings → Developer options → Wireless debugging</Bold> and turn it on.
                        </TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                            Tap <Bold>Pair device with QR code</Bold>.
                        </TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                            Scan this code. Your phone and this PC need to be on the <Bold>same Wi-Fi</Bold>.
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Can't find Developer options?">
                    <StackPanel Spacing="12">
                        <TextBlock TextWrapping="Wrap">
                            <Bold>Xiaomi, Redmi, POCO:</Bold> Settings → About phone → tap <Italic>OS version</Italic> (or <Italic>MIUI version</Italic>) 7 times.
                            Developer options is then under Settings → Additional settings. Also turn on <Bold>USB debugging (Security settings)</Bold>, otherwise you can see the screen but not control it.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Bold>Samsung:</Bold> Settings → About phone → Software information → tap <Italic>Build number</Italic> 7 times.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Bold>Pixel and most others:</Bold> Settings → About phone → tap <Italic>Build number</Italic> 7 times.
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Wireless debugging needs Android 11 or newer. On older phones, turn on USB debugging and plug in with a cable." />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Pair with a code instead">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="In Wireless debugging, tap 'Pair device with pairing code'. Enter the IP address and port, and the 6-digit code it shows." />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EndpointBox" Header="IP address &amp; port" PlaceholderText="192.168.1.20:37123" />
                            <TextBox x:Name="CodeBox" Grid.Column="1" Header="Pairing code" PlaceholderText="123456" MaxLength="6" InputScope="Number" />
                            <Button x:Name="CodePairButton" Grid.Column="2" VerticalAlignment="Bottom" Content="Pair" Style="{StaticResource AccentButtonStyle}" Click="CodePair_Click" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE88E;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="Have a USB cable? Turn on USB debugging and plug in. Tandem connects automatically." />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top" Margin="0,8,0,0">
                <Border Background="White" CornerRadius="12" Padding="18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid Width="232" Height="232">
                        <Image x:Name="QrImage" Stretch="Uniform" />
                        <ProgressRing x:Name="QrLoading" IsActive="True" Width="40" Height="40" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" MaxWidth="270">
                    <ProgressRing x:Name="StatusRing" IsActive="True" Width="16" Height="16" />
                    <FontIcon x:Name="StatusIcon" FontSize="16" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Starting…" />
                </StackPanel>
                <HyperlinkButton x:Name="NewCodeButton" Content="Show a new code" HorizontalAlignment="Center" Click="NewCode_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
