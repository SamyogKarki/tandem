<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tandem.App.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Tandem.App"
    xmlns:vm="using:Tandem.App.ViewModels"
    xmlns:svc="using:Tandem.App.Services">

    <Page.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
    </Page.Resources>

    <Grid Padding="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="20,8,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Back (Alt+Left)" Click="Back_Click"
                        IsEnabled="{x:Bind Vm.CanGoBack, Mode=OneWay}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Up" Click="Up_Click"
                        IsEnabled="{x:Bind Vm.CanGoUp, Mode=OneWay}">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Refresh (F5)" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- No x:Bind item template here: BreadcrumbBar hands its "…" overflow item a null
                 item, which a typed template can't handle. The default template shows ToString(). -->
            <BreadcrumbBar Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                           ItemsSource="{x:Bind Vm.Crumbs}" ItemClicked="Crumb_Clicked" />

            <CommandBar Grid.Column="2" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                <AppBarButton Label="New folder" Click="NewFolder_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Add from PC">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE898;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Files…" Click="UploadFiles_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Folder…" Click="UploadFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="DownloadButton" Label="Save to PC" Click="Download_Click" IsEnabled="False">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Delete" Click="Delete_Click" IsEnabled="False">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="RenameButton" Label="Rename" Click="Rename_Click" IsEnabled="False">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton Label="Show hidden files" IsChecked="{x:Bind Vm.ShowHidden, Mode=TwoWay}">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE7B3;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton Label="Open download folder" Click="OpenDownloads_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Padding="12,0,20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView ItemsSource="{x:Bind Vm.Places}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Place_Click">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:Place">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid x:Name="DropArea" AllowDrop="True" Background="Transparent"
                      DragOver="DropArea_DragOver" DragLeave="DropArea_DragLeave" Drop="DropArea_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,10,20,8" ColumnSpacing="12"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Date modified" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind Vm.Items}"
                              SelectionMode="Extended" CanDragItems="True" IsItemClickEnabled="False"
                              DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted"
                              DoubleTapped="FileList_DoubleTapped" RightTapped="FileList_RightTapped"
                              SelectionChanged="FileList_SelectionChanged" Padding="4,4">
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" Invoked="DeleteKey_Invoked" />
                            <KeyboardAccelerator Key="F2" Invoked="RenameKey_Invoked" />
                            <KeyboardAccelerator Key="Enter" Invoked="EnterKey_Invoked" />
                            <KeyboardAccelerator Key="Back" Invoked="BackKey_Invoked" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ContextFlyout>
                            <MenuFlyout x:Name="ItemMenu">
                                <MenuFlyoutItem Text="Open" Click="Open_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save to PC" Click="Download_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save to…" Click="DownloadTo_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Rename" Click="Rename_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Delete" Click="Delete_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItem">
                                <Grid ColumnSpacing="12" Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="{x:Bind IconOpacity}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ProgressRing Grid.Row="1" IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" Width="36" Height="36" />

                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind app:Ui.Show(Vm.ShowEmpty), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="This folder is empty" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Drop files here to copy them to your phone." HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Visibility="{x:Bind app:Ui.ShowText(Vm.Error), Mode=OneWay}">
                        <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Shown while PC files are dragged over -->
                    <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Margin="6">
                        <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4,3"
                                   Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.9" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="36" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DropText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,32,24"
                 MaxWidth="460" IsOpen="False" Severity="Success" />

        <!-- Transfers -->
        <Border Grid.Row="2" Margin="20,0,20,16" Style="{StaticResource CardStyle}" Padding="16,10"
                Visibility="{x:Bind TransfersVisibility(Transfers.Items.Count), Mode=OneWay}">
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="Transfers" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Clear finished" HorizontalAlignment="Right" Click="ClearTransfers_Click" />
                </Grid>
                <ScrollViewer MaxHeight="170">
                    <ItemsControl ItemsSource="{x:Bind Transfers.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:TransferItem">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind DirectionGlyph}" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Margin="0,0,160,0" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     Visibility="{x:Bind app:Ui.Show(IsActive), Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolButton}" Command="{x:Bind CancelCommand}" ToolTipService.ToolTip="Cancel"
                                                Visibility="{x:Bind app:Ui.Show(IsActive), Mode=OneWay}">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource ToolButton}" Command="{x:Bind ShowInFolderCommand}" ToolTipService.ToolTip="Show in folder"
                                                Visibility="{x:Bind app:Ui.Show(CanShowInFolder), Mode=OneWay}">
                                            <FontIcon Glyph="&#xE838;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
