<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tandem.App.Views.Setup.SetupGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:Tandem.App.Views.Setup"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer>
        <Grid MaxWidth="1000" Padding="40,28,40,40" HorizontalAlignment="Center">

            <!-- Returning user: phone paired before, just not here right now -->
            <Grid x:Name="WaitingPanel" Visibility="Collapsed" ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="18" MaxWidth="560">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="True" Width="22" Height="22" />
                        <TextBlock x:Name="WaitingTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="Tandem connects by itself when your phone is nearby. If it's taking a while, check these:" />
                    <StackPanel x:Name="WaitingChecks" Spacing="14" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Pair it again" Click="PairAgain_Click" />
                        <Button Content="Set up a different phone" Click="NewPhone_Click" />
                    </StackPanel>
                </StackPanel>
                <setup:PhoneMock x:Name="WaitingMock" Grid.Column="1" VerticalAlignment="Top" />
            </Grid>

            <!-- First-time guide -->
            <Grid x:Name="WizardPanel" ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="18" MaxWidth="580">
                    <TextBlock x:Name="StepLabel" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StepTitle" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="34" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepIntro" Style="{StaticResource SecondaryText}" />

                    <InfoBar x:Name="UnauthorizedBar" Severity="Informational" IsClosable="False" IsOpen="False"
                             Title="Check your phone"
                             Message="Tap Allow on the 'Allow USB debugging?' prompt. Tick 'Always allow from this computer' so you're not asked again." />

                    <Grid x:Name="BrandGrid" ColumnSpacing="10" RowSpacing="10" />
                    <StackPanel x:Name="StepList" Spacing="14" />

                    <Border x:Name="TipBorder" CornerRadius="8" Padding="14,10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA80;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel x:Name="TipText" Grid.Column="1" Spacing="6" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="PairExtras" Spacing="10" Visibility="Collapsed">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Pair with a code instead">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SecondaryText}"
                                           Text="In Wireless debugging, tap 'Pair device with pairing code'. Type the IP address and port, and the 6-digit code it shows." />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EndpointBox" Header="IP address &amp; port" PlaceholderText="192.168.1.20:37123" />
                                    <TextBox x:Name="CodeBox" Grid.Column="1" Header="Pairing code" PlaceholderText="123456" MaxLength="6" InputScope="Number" />
                                    <Button x:Name="CodePairButton" Grid.Column="2" VerticalAlignment="Bottom" Content="Pair"
                                            Style="{StaticResource AccentButtonStyle}" Click="CodePair_Click" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Use a USB cable instead">
                            <TextBlock TextWrapping="Wrap"
                                       Text="In Developer options, turn on USB debugging, then plug your phone into this PC. When the phone asks 'Allow USB debugging?', tap Allow. Tandem connects by itself." />
                        </Expander>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button x:Name="BackButton" Content="Back" Click="Back_Click" />
                        <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Top">
                    <setup:PhoneMock x:Name="Mock" />
                    <StackPanel x:Name="QrPanel" Spacing="14" Visibility="Collapsed" Margin="0,8,0,0">
                        <Border Background="White" CornerRadius="12" Padding="18"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid Width="232" Height="232">
                                <Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="Pairing QR code" />
                                <ProgressRing x:Name="QrLoading" IsActive="True" Width="40" Height="40" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" MaxWidth="270">
                            <ProgressRing x:Name="StatusRing" IsActive="True" Width="16" Height="16" />
                            <FontIcon x:Name="StatusIcon" FontSize="16" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Starting…" />
                        </StackPanel>
                        <HyperlinkButton Content="Show a new code" HorizontalAlignment="Center" Click="NewCode_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
