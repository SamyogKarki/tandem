<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tandem.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Tandem.App">

    <Page.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="820" Padding="40,28,40,40" Spacing="8">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start Tandem when you sign in to Windows" />
                        <TextBlock Text="Starts quietly in the system tray so your phone connects on its own." Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled" />
                </Grid>
            </Border>

            <TextBlock Text="Screen mirroring" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Resolution" />
                            <TextBlock Text="Lower is smoother on slow Wi-Fi." Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="SizeBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="170" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Phone's full resolution" Tag="0" />
                            <ComboBoxItem Content="1920 pixels" Tag="1920" />
                            <ComboBoxItem Content="1600 pixels" Tag="1600" />
                            <ComboBoxItem Content="1280 pixels" Tag="1280" />
                            <ComboBoxItem Content="1024 pixels" Tag="1024" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Video quality" />
                            <TextBlock Text="Higher looks sharper but needs more bandwidth." Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="BitRateBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="170" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Data saver (4 Mbps)" Tag="4" />
                            <ComboBoxItem Content="Balanced (8 Mbps)" Tag="8" />
                            <ComboBoxItem Content="High (16 Mbps)" Tag="16" />
                            <ComboBoxItem Content="Best (24 Mbps)" Tag="24" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Frame rate" VerticalAlignment="Center" />
                        <ComboBox x:Name="FpsBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="170" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="30 fps" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                            <ComboBoxItem Content="90 fps" Tag="90" />
                            <ComboBoxItem Content="120 fps" Tag="120" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Keep the mirror window on top of other windows" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="OnTopToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="Setting_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Phone notifications" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show message text in pop-ups" />
                            <TextBlock Text="Turn off if others can see your screen. Pop-ups then only say which app a notification is from." Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MessageTextToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="MessageText_Toggled" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Incoming calls" />
                            <TextBlock Text="Calls ring on this PC with Answer and Decline. You talk on the phone." Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="TestCallButton" Grid.Column="1" Content="Try a pretend call" Click="TestCall_Click" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon x:Name="ReconnectIcon" Glyph="&#xE895;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reconnect after your phone restarts" />
                            <TextBlock x:Name="ReconnectText" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Files" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Save phone files to" />
                        <TextBlock x:Name="DownloadFolderText" Style="{StaticResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Change…" Click="ChangeFolder_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VersionText" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Updates.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check for updates" Click="CheckUpdates_Click"
                                Visibility="{x:Bind app:Ui.Show(Updates.CanCheck), Mode=OneWay}" />
                        <Button Grid.Column="1" Content="Restart now" Click="RestartToUpdate_Click" Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind app:Ui.Show(Updates.IsReady), Mode=OneWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12">
                        Tandem uses <Hyperlink NavigateUri="https://github.com/Genymobile/scrcpy">scrcpy</Hyperlink> and Android's adb (Apache 2.0),
                        <Hyperlink NavigateUri="https://github.com/SharpAdb/AdvancedSharpAdbClient">AdvancedSharpAdbClient</Hyperlink> (Apache 2.0) and
                        <Hyperlink NavigateUri="https://github.com/codebude/QRCoder">QRCoder</Hyperlink> (MIT).
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
